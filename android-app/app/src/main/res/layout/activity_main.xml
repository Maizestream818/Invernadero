<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="APP DE MONITOREO"
                android:textColor="#DDEFE6"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Invernadero Inteligente IoT"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Monitoreo en tiempo real con actualizacion automatica cada 2 segundos."
                android:textColor="#DDEFE6"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="Conexion" />

        <LinearLayout
            style="@style/CardContainer"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="URL base de API"
                android:textColor="@color/color_text"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etApiBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="https://irregular-mothball-flyover.ngrok-free.dev/api"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="@color/color_text"
                android:textColorHint="@color/color_muted" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="La URL se guarda automaticamente al editarla o probar conexion."
                android:textColor="@color/color_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnProbarConexion"
                style="@style/ButtonSecondary"
                android:text="Probar conexion" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEstadoApi"
            style="@style/StatusBlock"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:minHeight="58dp"
            android:text="API desconectada" />

        <TextView
            android:id="@+id/tvUltimaActualizacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ultima actualizacion: Sin datos"
            android:textColor="@color/color_muted" />

        <TextView
            style="@style/SectionTitle"
            android:text="Sensores" />

        <TextView
            android:id="@+id/txtTarjetasSensores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Tarjetas de sensores en dos columnas"
            android:textColor="@color/color_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <include layout="@layout/item_sensor_temperatura" />
                <include layout="@layout/item_sensor_humedad_ambiente" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <include layout="@layout/item_sensor_humedad_suelo" />
                <include layout="@layout/item_sensor_humedad_raw" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <include layout="@layout/item_sensor_luz" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="Actuadores" />

        <TextView
            android:id="@+id/txtTarjetasActuadores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Tarjetas de actuadores con control integrado"
            android:textColor="@color/color_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/gridActuadoresAndroid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <include layout="@layout/item_actuador_ventilador" />
                <include layout="@layout/item_actuador_bomba" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <include layout="@layout/item_actuador_lampara" />
                <include layout="@layout/item_actuador_servo" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="Comandos pendientes" />

        <TextView
            android:id="@+id/tvComandosPendientes"
            style="@style/StatusBlock"
            android:text="Sin comandos pendientes" />

        <TextView
            style="@style/SectionTitle"
            android:text="Configuracion de automatizacion" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <include layout="@layout/item_config_temp_max" />
                <include layout="@layout/item_config_humedad_min" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <include layout="@layout/item_config_luz_min" />
                <include layout="@layout/item_config_ventilacion" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <include layout="@layout/item_config_riego" />
                <include layout="@layout/item_config_iluminacion" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <include layout="@layout/item_config_duracion_riego" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="Accesos RFID recientes" />

        <TextView
            android:id="@+id/tvAccesos"
            style="@style/TextBlock"
            android:text="Sin datos" />

        <TextView
            style="@style/SectionTitle"
            android:text="Comandos recientes" />

        <TextView
            android:id="@+id/tvComandos"
            style="@style/TextBlock"
            android:text="Sin datos" />

        <TextView
            android:id="@+id/tvNotaAlcance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="24dp"
            android:text="La app crea comandos pendientes para ventilador, bomba y lampara. El servo se mantiene controlado por RFID."
            android:textColor="@color/color_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
